# Local dev: run `supabase start` at the repo root, then copy the values
# from `supabase status` here (API URL + anon key). Save as .env.local.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Clerk publishable key (public by design — NOT the secret key; sk_* must
# never appear in this app). Also set your Clerk domain in
# supabase/config.toml [auth.third_party.clerk] and restart supabase, or
# PostgREST will reject Clerk tokens.
VITE_CLERK_PUBLISHABLE_KEY=

# Never set VITE_E2E here — it compiles the Playwright auth bridge into the
# app. Only scripts/run-e2e.ts sets it, for test builds.
