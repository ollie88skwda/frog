# Convex deployment the app talks to. Local dev: run a local backend
# (`CONVEX_AGENT_MODE=anonymous bunx convex dev` or `bunx convex dev --local`
# at the repo root, in its own terminal) and use its URL. Save as .env.local.
VITE_CONVEX_URL=http://127.0.0.1:3210

# Clerk publishable key (public by design — NOT the secret key; sk_* must
# never appear in this app). The Convex deployment must have
# CLERK_JWT_ISSUER_DOMAIN set to this Clerk instance's issuer, and the
# instance needs a JWT template named "convex" (audience "convex"), or every
# call is rejected as signed out.
VITE_CLERK_PUBLISHABLE_KEY=

# Never set VITE_E2E here — it compiles the Playwright auth bridge into the
# app. Only scripts/run-e2e.ts sets it, for test builds.
