{
  "name": "frog",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "test": "bun run --filter '*' test",
    "test:integration": "bun run --cwd packages/core test:integration",
    "e2e": "bun scripts/run-e2e.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.61.1",
    "@supabase/supabase-js": "^2.110.2",
    "@types/node": "^26.1.1",
    "convex": "1.49.0",
    "convex-test": "0.0.66",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.2",
    "vite": "^7.1.11"
  }
}
