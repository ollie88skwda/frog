{
  "name": "frog",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "test": "bun run --filter '*' test",
    "test:integration": "bun scripts/convex-test-env.ts && bun run --cwd packages/core test:integration",
    "e2e": "bun scripts/run-e2e.ts",
    "typecheck": "bun run --filter '*' typecheck && tsc -p convex",
    "lint": "biome check .",
    "format": "biome format --write .",
    "convex:seed": "bun scripts/seed-convex.ts",
    "convex:seed:generate": "bun scripts/seed-convex.ts --generate",
    "import:supabase": "bun scripts/import-from-supabase.ts",
    "test:import": "bun scripts/convex/import-roundtrip.ts",
    "deploy": "bun run --cwd apps/web build && wrangler deploy",
    "preview:cf": "wrangler dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "convex": "1.49.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.11",
    "wrangler": "^4.159.0"
  }
}
